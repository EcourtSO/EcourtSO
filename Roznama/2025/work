    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4} to [:digit:]{1,4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

    ' ------------------------------------------------------------
    ' Step 20: Devanagari with "and" (e.g., "प्रकरण क्र.1 and 2")
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4} and [:digit:]{1,4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

    ' ------------------------------------------------------------
    ' Step 21: Devanagari with year format (e.g., "प्रकरण क्र.123/2025")
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4}/[:digit:]{4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

    ' ------------------------------------------------------------
    ' Step 22: Devanagari with year + range (e.g., "प्रकरण क्र.123/2025-126/2025")
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4}/[:digit:]{4}-[:digit:]{1,4}/[:digit:]{4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

    ' ------------------------------------------------------------
    ' Step 23: Devanagari with year + "to" (e.g., "प्रकरण क्र.123/2025 to 130/2025")
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4}/[:digit:]{4} to [:digit:]{1,4}/[:digit:]{4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

    ' ------------------------------------------------------------
    ' Step 24: Devanagari with year + "and" (e.g., "प्रकरण क्र.123/2025 and 124/2025")
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "^प्रकरण क्र.[:digit:]{1,4}/[:digit:]{4} and [:digit:]{1,4}/[:digit:]{4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Shree-Devanagari 714"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i
    ' ------------------------------------------------------------
    ' Step 25: Witness references (Prosecution / Defence Witness)
    ' Examples: "PW-1", "P.W.1", "DW-2", "D.W.2", etc.
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = _
        "(P|p)\.?W\.?-?\s?[:digit:]{1,4}|" & _
        "(D|d)\.?W\.?-?\s?[:digit:]{1,4}"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharFontName = "Bitstream Charter"
        foundText.CharHeight   = 12
        foundText.CharWeight   = 150
    Next i

