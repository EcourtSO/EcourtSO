    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "Judgment"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharWeight = 150   ' Bold
    Next i

    ' ------------------------------------------------------------
    ' Step 29: Heading "Final Order" (bold)
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "Final Order"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharWeight = 150   ' Bold
    Next i

    ' ------------------------------------------------------------
    ' Step 30: Heading "Proceeding is closed" (bold)
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "Proceeding is closed"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.CharWeight = 150   ' Bold
    Next i
    ' ------------------------------------------------------------
    ' Step 31: Align "Proceeding is closed" lines to the right
    ' ------------------------------------------------------------
    regexDesc = ThisComponent.createReplaceDescriptor
    regexDesc.searchRegularExpression = True
    regexDesc.searchString = "Proceeding is closed"

    foundRanges = ThisComponent.findAll(regexDesc)
    For i = 0 To foundRanges.Count - 1
        foundText = foundRanges.getByIndex(i)
        foundText.ParaAdjust = com.sun.star.style.ParagraphAdjust.RIGHT
    Next i

    ' ------------------------------------------------------------
    ' Step 32: Remove extra spaces before punctuation
    ' (e.g., " ,", " .", " :", " ;")
    ' ------------------------------------------------------------
    docCleanup = ThisComponent
    replaceDesc = docCleanup.createReplaceDescriptor
    With replaceDesc
        .SearchRegularExpression = True
        .SearchString = " ,"
        .ReplaceString = ","
    End With
    docCleanup.replaceAll(replaceDesc)

    replaceDesc.SearchString = " \."
    replaceDesc.ReplaceString = "."
    docCleanup.replaceAll(replaceDesc)

    replaceDesc.SearchString = " :"
    replaceDesc.ReplaceString = ":"
    docCleanup.replaceAll(replaceDesc)

    replaceDesc.SearchString = " ;"
    replaceDesc.ReplaceString = ";"
    docCleanup.replaceAll(replaceDesc)

    ' ------------------------------------------------------------
    ' Step 33: Normalize multiple spaces into single space
    ' ------------------------------------------------------------
    replaceDesc.SearchString = " {2,}"
    replaceDesc.ReplaceString = " "
    docCleanup.replaceAll(replaceDesc)

    ' ------------------------------------------------------------
    ' Step 34: Trim spaces at beginning of lines
    ' ------------------------------------------------------------
    replaceDesc.SearchString = "^ "
    replaceDesc.ReplaceString = ""
    docCleanup.replaceAll(replaceDesc)

    ' ------------------------------------------------------------
    ' Step 35: Trim spaces at end of lines
    ' ------------------------------------------------------------
    replaceDesc.SearchString = " $"
    replaceDesc.ReplaceString = ""
    docCleanup.replaceAll(replaceDesc)

    ' ------------------------------------------------------------
    ' Step 36: Normalize repeated dots (e.g., "....." → "...")
    ' ------------------------------------------------------------
    replaceDesc.SearchString = "\.{4,}"
    replaceDesc.ReplaceString = "..."
    docCleanup.replaceAll(replaceDesc)

    ' ------------------------------------------------------------
    ' Step 37: Final paragraph alignment for judge's name
    ' Example: Align to right for last paragraph if needed
    ' ------------------------------------------------------------
    viewCursor.gotoEnd(False)
    viewCursor.ParaAdjust = com.sun.star.style.ParagraphAdjust.RIGHT

    ' ------------------------------------------------------------
    ' Step 38: Ensure consistent font for entire document body
    ' ------------------------------------------------------------
    dispatcher.executeDispatch(docFrame, ".uno:SelectAll", "", 0, Array())

    Dim fontArgs(2) As New com.sun.star.beans.PropertyValue
    fontArgs(0).Name  = "CharFontName"
    fontArgs(0).Value = "Bitstream Charter"
    fontArgs(1).Name  = "CharHeight"
    fontArgs(1).Value = 12
    fontArgs(2).Name  = "CharWeight"
    fontArgs(2).Value = 100  ' normal

    dispatcher.executeDispatch(docFrame, ".uno:CharFontName", "", 0, fontArgs())

    ' ------------------------------------------------------------
    ' End of Macro
    ' ------------------------------------------------------------
End Sub
